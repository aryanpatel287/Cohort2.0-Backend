# Stage 1: Build the frontend
FROM node:20-alpine AS frontend_builder

WORKDIR /app

COPY client/package*.json ./

RUN npm install 

COPY ./client /app/

RUN npm run build

# Stage 2: Build the FullStack Image
FROM node:20-alpine 

WORKDIR /app

COPY server/package*.json ./

RUN npm install

COPY ./server /app/

COPY  --from=frontend_builder app/dist /app/public

CMD ["node", "server.js"]